# Copy this file to .env and fill in the values.
# Then run: node scripts/build-config.mjs   (writes assets/js/config.js)

# Form API base URL, no trailing slash. Empty = demo mode (no network calls).
SB_API_URL=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Empty = analytics off.
SB_GA_ID=
